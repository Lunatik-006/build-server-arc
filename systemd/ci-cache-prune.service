[Unit]
Description=Drop files untouched for 14 days from the shared CI dependency caches

[Service]
Type=oneshot
# / is mounted relatime, so atime moves at least once a day for anything read.
ExecStart=/usr/bin/find /opt/ci-cache /opt/ci-cache-containers /opt/ci-cache-tier -path '*/node_modules/*' -prune -o -type f -atime +14 -delete
# A node_modules tree is one unit: the node-modules action touches it on every use,
# so a tree (or a half-written .tmp of a killed job) untouched for 7 days goes whole.
ExecStart=/usr/bin/find /opt/ci-cache-tier -mindepth 3 -maxdepth 3 -path '*/node_modules/*' -mtime +7 -exec rm -rf {} +
